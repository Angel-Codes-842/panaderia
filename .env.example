# ===================================
# Configuración para producción local con Docker
# Copia este archivo a .env y ajusta los valores
# ===================================

# Entorno
NODE_ENV=production
TZ=America/Asuncion

# Puerto publicado por Docker (el contenedor escucha en el puerto 3000)
APP_PORT=3000
APP_BIND_IP=0.0.0.0

# Base de datos PostgreSQL
# Si usas docker-compose con el servicio 'db', usa estos valores
POSTGRES_USER=panaderia
POSTGRES_PASSWORD=
POSTGRES_DB=panaderia

# Directorio de datos persistentes (dentro del contenedor)
DATA_DIR=/app/data

# Límites pensados para una notebook de bajo consumo (ajustables)
APP_CPUS=1.0
APP_MEMORY_LIMIT=512m
DB_CPUS=1.0
DB_MEMORY_LIMIT=768m
DB_POOL_MAX=5

# Los backups quedan en una carpeta del host para poder copiarlos fuera del contenedor
BACKUP_PATH=./backups

# Solo se usan al crear el primer usuario de una base vacía.
# Completá la contraseña antes de iniciar Docker; no uses una clave compartida.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=

# ===================================
# Seguridad y red
# ===================================

# Si vas a acceder directamente por IP:Puerto (Tailscale IP:3000) deja en 0 o sin definir
# Si vas a ponerlo detrás de un reverse proxy (nginx/traefik) pon TRUST_PROXY=1
TRUST_PROXY=0

# Si el proxy/reverse proxy maneja HTTPS y pasa X-Forwarded-Proto https
# Esto hace que las cookies se marquen como Secure
HTTPS=0

# ===================================
# Comportamiento de la app
# ===================================

# Docker está configurado para no sembrar datos de demostración.
# El seed solo se habilita explícitamente en entornos de prueba.

# Caché de licencia en ms (30000 por defecto). Poner 0 solo para tests
LICENCIA_CACHE_MS=30000
